# ══════════════════════════════════════════════════════════════════════════════
# Banco Atlântico — Configuração de Observabilidade
# Copie para .env e preencha os valores da sua Tenant Dynatrace
# ══════════════════════════════════════════════════════════════════════════════

# ── Dynatrace Tenant ──────────────────────────────────────────────────────────
# URL da sua Tenant (sem barra final)
DT_TENANT=https://XXXXXX.live.dynatrace.com

# API Token — scopes obrigatórios:
#   bizevents.ingest           → BizEvents directos dos serviços
#   openTelemetryTrace.ingest  → Traces via OTel Collector
#   metrics.ingest             → Métricas via OTel Collector
#   logs.ingest                → Logs via OTel Collector (opcional)
DT_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── RUM (Real User Monitoring) ────────────────────────────────────────────────
# 1. Aceda a: Settings → Web & Mobile Monitoring → Applications → New Application
# 2. Seleccione "Custom application" e configure o domínio (localhost)
# 3. Vá em "Instrumentation" e copie o URL do script (o src= do snippet)
# 4. Cole o URL completo abaixo (sem as tags <script>)
#
# Exemplo:
# DT_RUM_SCRIPT_SRC=https://js-cdn.dynatrace.com/jstag/abc123/ruxitagentjs_XXXXX_10284.js
#
# Deixe vazio para desactivar RUM (a demo funciona sem ele):
DT_RUM_SCRIPT_SRC=

# ── Simulador de Tráfego ──────────────────────────────────────────────────────
# Número de operações por segundo geradas pelo simulador automático
EVENTS_PER_SECOND=15
